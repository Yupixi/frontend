# Production server of the storefront. Nixpacks builds the Vite app and
# serves it with Caddy; nixpacks.toml starts Caddy on this file instead of
# Nixpacks' default one (same base: SPA fallback, gzip, /health), adding
# cache and security headers. `serve.json` only applies to `serve`, which
# this deployment does not use.
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

# The backend that renders pages for search engines (Backend
# src/modules/seo). SEO_BACKEND_URL = the API's public address; the
# visitor's host tells it which storefront (it must be in the API's
# SITE_URL or CORS_ORIGIN list).
(seo_backend) {
	reverse_proxy {$SEO_BACKEND_URL:https://yupixi-backend-gahuiz-52bc79-82-29-184-109.sslip.io} {
		header_up Host {upstream_hostport}
		header_up X-Site-Host {hostport}
		# The API's own security headers (helmet: CSP default-src 'self'…)
		# would stop the page from calling the API: the storefront's apply.
		header_down -Content-Security-Policy
		header_down -Cross-Origin-Opener-Policy
		header_down -Cross-Origin-Resource-Policy
		header_down -Origin-Agent-Cluster
		header_down -X-Frame-Options
		header_down -X-XSS-Protection
		header_down -X-DNS-Prefetch-Control
		header_down -X-Download-Options
		header_down -X-Permitted-Cross-Domain-Policies
		header_down -Referrer-Policy
		header_down -Strict-Transport-Security
		transport http {
			dial_timeout 3s
			response_header_timeout 8s
		}
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	root * /app/{$NIXPACKS_SPA_OUTPUT_DIR:dist}

	encode zstd gzip

	header {
		X-Frame-Options DENY
		# Only directives nothing in the app needs to cross: no page of
		# another site may frame it; a form (e.g. a fake « confirm your
		# payment » inside a listing description) can only post to Dilchap;
		# no <base> hijacking relative links; no plugins. img-src/script-src/
		# connect-src are left open on purpose: listing photos (MinIO host of
		# each environment, older external URLs), Google Fonts, map tiles,
		# ipwho.is, Lottie and the analytics tags would each need listing
		# (Google Analytics; Microsoft Clarity: https://*.clarity.ms and
		# https://c.bing.com for script, connect and img, if these
		# directives are ever added).
		Content-Security-Policy "frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Build output with a content hash in the name (Vite chunks, the icon
	# font subset): a new build ships new names, so browsers keep these for
	# a year without asking again.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@hashed_font path_regexp ^/fonts/.+-[0-9a-f]{8}\.woff2$
	header @hashed_font Cache-Control "public, max-age=31536000, immutable"

	# Fixed names in public/ (logo, payment logos, icons): a day, then a
	# cheap revalidation.
	@images {
		path *.png *.jpg *.jpeg *.webp *.svg *.ico
		not path /assets/*
	}
	header @images Cache-Control "public, max-age=86400"

	# Everything else — the HTML shell, the service worker, the manifest —
	# is always checked (ETag, 304 when unchanged) so a deploy shows up on
	# the next visit. `?` only sets it when no rule above did.
	header ?Cache-Control "no-cache"

	# Health check of the platform: the app shell, without the backend.
	handle /health {
		rewrite * /index.html
		file_server
	}

	# The API on the storefront's own address, so it needs no public host of
	# its own: GraphQL (HTTP and the chat's WebSocket), uploads and the
	# payment webhook go to the backend over the internal network.
	# API_UPSTREAM = the backend (e.g. http://dilchap-backend:3000 on the
	# same Docker network); the build then leaves VITE_GRAPHQL_API_URL empty
	# and the app calls <this origin>/graphql.
	@api path /graphql /graphql/* /uploads /uploads/* /kyc/uploads /shops/uploads /webhooks/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:https://yupixi-backend-gahuiz-52bc79-82-29-184-109.sslip.io} {
			header_up Host {upstream_hostport}
		}
	}

	# Search engines: robots.txt, sitemap.xml (an index) and its files
	# under /sitemaps/ come from the backend
	# (Backend src/modules/seo), which knows the live listings and shops.
	@seo_files path /robots.txt /sitemap.xml /sitemaps/*
	handle @seo_files {
		rewrite * /seo{path}
		import seo_backend
	}

	# Printed QR codes of the shops: https://<site>/q/<code> never changes.
	# The backend counts the scan (no IP kept) and answers a 302 to the
	# shop once the QR is active, else the app's page (launch page, blank
	# or inactive QR), noindex and never cached. Backend down: the app
	# shell (handle_errors), whose /q/ page asks the API itself.
	handle /q/* {
		rewrite * /seo{path}
		import seo_backend
	}

	# One-click account confirmation links sent by SMS:
	# https://<site>/v/<code>. Like /q/, it works while the launch page is
	# up: the backend answers the app's page, noindex and never cached; the
	# app (outside the launch page) uses the link through GraphQL, so a link
	# preview fetching this address uses nothing up. Backend down: the app
	# shell (handle_errors), which asks the API itself.
	handle /v/* {
		rewrite * /seo{path}
		import seo_backend
	}

	# The web app manifest of a tester (?equipe=1, set by the app once the
	# key is confirmed; the key itself is in the dilchap_acces cookie, never
	# in the page — older apps sent ?acces=…): the backend checks the key
	# and answers the manifest with a start_url that carries it, so the app
	# installed on a phone's home screen opens the preview too (iPhones give
	# it its own storage, without the key). Without the parameter: the
	# static file below.
	@manifest_key {
		path /manifest.json
		query acces=*
	}
	handle @manifest_key {
		rewrite * /seo/manifest.json
		import seo_backend
	}
	@manifest_team {
		path /manifest.json
		query equipe=1
	}
	handle @manifest_team {
		rewrite * /seo/manifest.json
		import seo_backend
	}

	# Storefront pages (/, /annonce/…, /categorie/…, /boutique/…: every
	# path without a file extension) come back from the backend as the
	# app's own index.html with the page's title, description, share image,
	# canonical URL and structured data, for search engines and link
	# previews (WhatsApp, Facebook). The app then starts as usual.
	@page {
		method GET HEAD
		not path_regexp \.[A-Za-z0-9]+$
	}
	handle @page {
		rewrite * /seo/page{path}
		import seo_backend
	}

	# Hashed build files: a name the current build doesn't have (a page
	# rendered from the previous build during a deploy) is a plain 404 that
	# no cache keeps — never the app shell, which the CDN would otherwise
	# store for a year under the script's name and break the site.
	handle /assets/* {
		@missing not file
		handle @missing {
			header Cache-Control "no-store"
			respond 404
		}
		file_server
	}

	# Files of the build (JS, CSS, images, fonts, the index.html itself).
	handle {
		try_files {path} /index.html
		file_server
	}

	# Backend unreachable or too slow: the plain app shell, the site keeps
	# working (with the build's default title and share tags).
	handle_errors {
		# The manifest with a key, backend unreachable: the static one.
		@manifest_down {
			path /manifest.json
			expression `{err.status_code} >= 502 && {err.status_code} <= 504`
		}
		handle @manifest_down {
			rewrite * /manifest.json
			file_server
		}
		@backend_down expression `{err.status_code} >= 502 && {err.status_code} <= 504`
		handle @backend_down {
			rewrite * /index.html
			file_server
		}
	}
}
